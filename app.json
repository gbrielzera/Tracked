{
  "expo": {
    "name": "Tracked",
    "slug": "tracked",
    "scheme": "tracked",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#17121F",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17121F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Tracked usa suas fotos para você escolher a foto de perfil."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gbrielzera.tracked"
    },
    "android": {
      "package": "com.gbrielzera.tracked",
      "adaptiveIcon": {
        "backgroundColor": "#17121F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2b30385b-56dd-4cd8-9fd7-785b7e376ba4"
      }
    },
    "owner": "gbrielzera"
  }
}
